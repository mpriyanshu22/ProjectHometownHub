# Hometown Hub Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/hometownhub

# JWT Secret Key (use a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Cookie Secret Key (use a strong random string in production)
COOKIE_SECRET=your-super-secret-cookie-key-change-this-in-production

# Node Environment (development/production)

